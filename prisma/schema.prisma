generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

// Per passare a MySQL in futuro, cambia 'provider = "sqlite"' in 'provider = "mysql"'
// e aggiorna il DATABASE_URL nel file .env (es. mysql://user:password@localhost:3306/cantina)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Wine {
  id              Int      @id @default(autoincrement())
  name            String
  vintage         String?
  country         String?
  region          String?
  position        String?
  collocation     String?
  shelfNumber     String?
  producerCellar  String?
  producer        String?
  classification  String?
  category        String?
  type            String?
  alcoholContent  Float?
  tempMin         Float?
  tempMax         Float?
  bottleType      String?
  notes           String?
  photo           String?
  photoBack       String?
  isArchived      Boolean  @default(false)
  
  grapeVarieties  GrapeVariety[]
  movements       Movement[]
  archivedPhotos  WinePhoto[]
  inventoryItems  InventoryItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GrapeVariety {
  id         Int    @id @default(autoincrement())
  name       String
  percentage Float?
  
  wineId     Int
  wine       Wine   @relation(fields: [wineId], references: [id], onDelete: Cascade)
}

model Location {
  id        Int        @id @default(autoincrement())
  name      String     @unique // es. "Cantina Arezzo", "Cantina Milano"
  
  parentId  Int?
  parent    Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Location[] @relation("LocationHierarchy")

  movements Movement[]
  inventoryItems InventoryItem[]
}

model Movement {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  movementType  String   // "Ingresso" o "Uscita"
  quantity      Int
  bottleType    String?
  position      String?
  collocation   String?
  shelfNumber   String?
  reason        String?
  vendor        String?
  price         Float?
  tempPrice     Float?   // Prezzo provvisorio
  notes         String?  // Nota per il movimento
  user          String?  // Utente che ha effettuato il movimento
  
  wineId        Int
  wine          Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  
  locationId    Int?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
}

model WinePhoto {
  id        Int      @id @default(autoincrement())
  url       String
  type      String   // "Fronte" o "Retro"
  wineId    Int
  wine      Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model User {
  id                Int           @id @default(autoincrement())
  username          String        @unique
  passwordHash      String
  role              String        @default("user") // "admin", "editor", "viewer"
  isActive          Boolean       @default(true)
  autoLogoutEnabled Boolean       @default(true)
  autoLogoutMinutes Int           @default(30)
  maxDevices        Int           @default(2)
  allowedLocations  String?       @default("ALL")
  canAccessInventory Boolean      @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sessions          UserSession[]
}

model UserSession {
  id           Int       @id @default(autoincrement())
  userId       Int?
  username     String
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginTime    DateTime  @default(now())
  logoutTime   DateTime?
  logoutReason String?   // "manual", "auto_timeout", "force"
  ipAddress    String?
  userAgent    String?
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SystemSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model InventorySession {
  id          Int             @id @default(autoincrement())
  title       String
  year        Int             @default(2026)
  status      String          @default("in_progress") // "in_progress", "completed", "cancelled"
  notes       String?
  createdBy   String?
  createdAt   DateTime        @default(now())
  completedAt DateTime?
  updatedAt   DateTime        @updatedAt

  items       InventoryItem[]
}

model InventoryItem {
  id          Int              @id @default(autoincrement())
  sessionId   Int
  session     InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  wineId      Int
  wine        Wine             @relation(fields: [wineId], references: [id], onDelete: Cascade)
  
  locationId  Int?
  location    Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)

  expectedQty Int              @default(0)
  countedQty  Int?
  isChecked   Boolean          @default(false)
  notes       String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}
